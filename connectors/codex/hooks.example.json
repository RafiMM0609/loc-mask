{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/pii-shield/.venv/bin/python ~/pii-shield/connectors/codex/codex_hook_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/pii-shield/.venv/bin/python ~/pii-shield/connectors/codex/codex_shell_output_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
